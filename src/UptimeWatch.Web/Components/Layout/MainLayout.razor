@inherits LayoutComponentBase

<div class="page">
    <NavMenu />

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout_ErrorUi_Message"]
    <a href="." class="reload">@L["Layout_ErrorUi_Reload"]</a>
    <span class="dismiss" role="button" aria-label="@L["Layout_ErrorUi_Dismiss"]">🗙</span>
</div>
