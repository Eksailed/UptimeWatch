@implements IDisposable

@inject NavigationManager NavigationManager

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="" aria-label="UptimeWatch">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">UptimeWatch</span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-label="Меню" />
        <label for="nav-toggle" class="nav-toggle" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M3 5.5h14M3 10h14M3 14.5h14" />
            </svg>
        </label>

        <div class="nav-panel" onclick="if (event.target.closest('a')) document.getElementById('nav-toggle').checked = false">
            <nav class="nav-links" aria-label="Основная навигация">
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="nav-link-item" href="monitors">Мониторы</NavLink>
                        <NavLink class="nav-link-item" href="profile">Профиль</NavLink>
                    </Authorized>
                </AuthorizeView>
            </nav>

            <div class="nav-end">
                @* Placeholder for the language switcher (stage 2). *@
                <div class="lang-switch-slot"></div>

                <AuthorizeView>
                    <Authorized>
                        <NavLink class="nav-user" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                        <form action="Account/Logout" method="post" class="nav-logout">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Выйти</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink class="nav-link-item" href="Account/Login">Войти</NavLink>
                        <a class="btn btn-primary btn-sm" href="Account/Register">Регистрация</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

