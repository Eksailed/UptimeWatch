@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using UptimeWatch.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>@L["Manage_2fa_Title"]</PageTitle>

<StatusMessage />
<h3>@L["Manage_2fa_Title"]</h3>
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>@L["Manage_2fa_NoCodes"]</strong>
                <p>@L.Html("Manage_2fa_NoCodesText", LocalizerMarkup.Anchor(L["Manage_2fa_GenerateLink"], "Account/Manage/GenerateRecoveryCodes"))</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>@L["Manage_2fa_OneCode"]</strong>
                <p>@L.Html("Manage_2fa_OneCodeText", LocalizerMarkup.Anchor(L["Manage_2fa_GenerateLink"], "Account/Manage/GenerateRecoveryCodes"))</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>@L["Manage_2fa_FewCodes", recoveryCodesLeft]</strong>
                <p>@L.Html("Manage_2fa_FewCodesText", LocalizerMarkup.Anchor(L["Manage_2fa_GenerateLink"], "Account/Manage/GenerateRecoveryCodes"))</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">@L["Manage_2fa_Forget"]</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-primary">@L["Manage_Disable2fa_Submit"]</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-primary">@L["Manage_2fa_ResetCodes"]</a>
    }

    <h4>@L["Manage_2fa_App"]</h4>
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@L["Manage_2fa_AddApp"]</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@L["Manage_2fa_SetupApp"]</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn btn-primary">@L["Manage_2fa_ResetApp"]</a>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>@L["Manage_2fa_PolicyTitle"]</strong>
        <p>@L["Manage_2fa_PolicyText"]</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            L["Manage_2fa_Forgotten"],
            HttpContext);
    }
}
