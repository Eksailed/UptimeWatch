@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>@L["Manage_PersonalData_Title"]</PageTitle>

<StatusMessage />
<h3>@L["Manage_PersonalData_Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@L["Manage_PersonalData_Text"]</p>
        <p>
            <strong>@L["Manage_Delete_Warning"]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@L["Manage_PersonalData_Download"]</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">@L["Manage_PersonalData_Delete"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
