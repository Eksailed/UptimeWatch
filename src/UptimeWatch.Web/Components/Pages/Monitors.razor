@page "/monitors"
@attribute [Authorize]
@* No prerender: the page loads data and subscribes to updates, which must happen once, in the circuit. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@using UptimeWatch.Application
@using UptimeWatch.Web.Realtime

@inject MonitorService MonitorService
@inject ICurrentUser CurrentUser
@inject MonitorUpdatesBroadcaster Updates
@inject ILogger<Monitors> Logger

<PageTitle>@L["Monitors_Title"]</PageTitle>

<div class="page-head">
    <h1>@L["Monitors_Title"]</h1>
</div>

@if (!loading && !loadFailed)
{
    <div class="summary" aria-label="@L["Monitors_Summary"]">
        <div class="summary-item">
            <span class="label">@L["Monitors_Total"]</span>
            <span class="value">@monitors.Count</span>
        </div>
        <div class="summary-item is-ok">
            <span class="label">@L["Monitors_Up"]</span>
            <span class="value">@monitors.Count(m => m.Enabled && !m.IsDown)</span>
        </div>
        <div class="summary-item is-down">
            <span class="label">@L["Monitors_Down"]</span>
            <span class="value">@monitors.Count(m => m.Enabled && m.IsDown)</span>
        </div>
    </div>
}

<AddMonitorForm Busy="busy" OnSubmit="AddAsync" />

@if (pageError is not null)
{
    <div class="alert alert-danger" role="alert">@pageError</div>
}

@if (loading)
{
    <div class="state-loading" role="status">@L["Common_Loading"]</div>
}
else if (loadFailed)
{
    @* The error above is all there is to show: the list is unknown, not empty. *@
}
else if (monitors.Count == 0)
{
    <div class="state-empty">
        <strong>@L["Monitors_Empty_Title"]</strong>
        @L["Monitors_Empty_Text"]
    </div>
}
else
{
    <div class="monitor-grid">
        @foreach (var monitor in monitors)
        {
            <article class="monitor-card @(monitor.Enabled && monitor.IsDown ? "is-down" : null)" @key="monitor.Id">
                <div class="monitor-head">
                    <span class="status-dot @StatusDotClass(monitor)" aria-hidden="true"></span>
                    <div class="monitor-title">
                        <a class="monitor-domain" href="monitors/@monitor.Id">@MonitorUrl.Domain(monitor.Url)</a>
                        <span class="monitor-url">@monitor.Url</span>
                    </div>
                    <StatusBadge Monitor="monitor" />
                </div>

                <dl class="metrics">
                    <div class="metric">
                        <dt>@L["Monitors_Code"]</dt>
                        <dd>@(monitor.LastStatusCode?.ToString() ?? "—")</dd>
                    </div>
                    <div class="metric">
                        <dt>@L["Monitors_ResponseTime"]</dt>
                        <dd>@(monitor.LastResponseTimeMs is { } ms ? L["Monitors_Ms", ms].Value : "—")</dd>
                    </div>
                    <div class="metric">
                        <dt>@L["Monitors_Checked"]</dt>
                        <dd>
                            @if (monitor.LastCheckedAt is { } checkedAt)
                            {
                                <time datetime="@checkedAt.ToString("O")">@UiFormat.Time(checkedAt)</time>
                            }
                            else
                            {
                                <span>@L["Monitors_NotChecked"]</span>
                            }
                        </dd>
                    </div>
                </dl>

                <div class="uptime-bars">
                    <UptimeBar Label="@L["Monitors_Uptime24h"]" Value="monitor.Uptime.Last24h" />
                    <UptimeBar Label="@L["Monitors_Uptime7d"]" Value="monitor.Uptime.Last7d" />
                    <UptimeBar Label="@L["Monitors_Uptime30d"]" Value="monitor.Uptime.Last30d" />
                </div>

                <div class="monitor-foot">
                    <span class="monitor-config">@L["Monitors_Config", monitor.IntervalSeconds, monitor.ExpectedStatusCode]</span>
                    <div class="monitor-actions">
                        <button class="btn btn-outline-secondary btn-icon" disabled="@busy" @onclick="() => ToggleAsync(monitor)"
                                title="@(monitor.Enabled ? L["Monitors_PauseTitle"] : L["Monitors_ResumeTitle"])"
                                aria-label="@(monitor.Enabled ? L["Monitors_Pause"] : L["Monitors_Resume"]): @MonitorUrl.Domain(monitor.Url)">
                            @if (monitor.Enabled)
                            {
                                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="3.5" y="3" width="3" height="10" rx="1" /><rect x="9.5" y="3" width="3" height="10" rx="1" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.4 2.7a.6.6 0 0 0-.9.5z" /></svg>
                            }
                            @(monitor.Enabled ? L["Monitors_Pause"] : L["Monitors_Resume"])
                        </button>
                        <button class="btn btn-outline-danger btn-icon" disabled="@busy" @onclick="() => DeleteAsync(monitor)"
                                title="@L["Monitors_DeleteTitle"]" aria-label="@L["Monitors_Delete"]: @MonitorUrl.Domain(monitor.Url)">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4h11M6 4V2.5h4V4M4 4l.6 9a1 1 0 0 0 1 .9h4.8a1 1 0 0 0 1-.9L12 4" /></svg>
                            @L["Monitors_Delete"]
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly List<MonitorStatusDto> pendingUpdates = [];
    private List<MonitorStatusDto> monitors = [];
    private IDisposable? subscription;
    private string? pageError;
    private bool loading = true;
    private bool loadFailed;
    private bool busy;
    private bool isDisposed;

    protected override void OnInitialized()
    {
        // Subscribe before loading, so an update published while the list is loading is not lost.
        subscription = Updates.Subscribe(CurrentUser.UserId, OnUpdateAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        pageError = await RunAsync(LoadAsync, "Monitors_LoadFailed");
        loadFailed = pageError is not null;
        loading = false;
        foreach (var update in pendingUpdates)
        {
            ApplyUpdate(update);
        }

        pendingUpdates.Clear();
    }

    private async Task LoadAsync()
    {
        // The list is always loaded for the signed-in user; ids sent by the browser are never trusted.
        monitors = (await MonitorService.ListAsync(CurrentUser.UserId, cancellation.Token)).ToList();
    }

    private Task OnUpdateAsync(MonitorStatusDto status)
    {
        if (isDisposed)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            if (isDisposed)
            {
                return;
            }

            if (loading)
            {
                pendingUpdates.Add(status);
                return;
            }

            ApplyUpdate(status);
            StateHasChanged();
        });
    }

    private void ApplyUpdate(MonitorStatusDto status)
    {
        // Only cards that are already on the page are updated: new monitors are added by this page itself, and a
        // late event cannot bring back a monitor that was just deleted. A monitor created in another tab shows up on reload.
        var index = monitors.FindIndex(m => m.Id == status.Id);
        if (index < 0 || monitors[index].LastCheckedAt > status.LastCheckedAt)
        {
            return;
        }

        // The event carries the monitor state at the time of the check; keep the Enabled flag set on this page.
        monitors[index] = status with { Enabled = monitors[index].Enabled };
    }

    private async Task<string?> AddAsync(string url, int intervalSeconds, int expectedStatusCode)
    {
        string? validationError = null;
        var failure = await RunAsync(async () =>
        {
            var result = await MonitorService.CreateAsync(
                CurrentUser.UserId, url, intervalSeconds, expectedStatusCode, cancellation.Token);
            if (result.Value is { } created)
            {
                pageError = null;
                InsertSorted(created);
            }
            else
            {
                validationError = result.Error is { } error ? L.Text(error) : null;
            }
        }, "Monitors_AddFailed");

        return validationError ?? failure;
    }

    private async Task ToggleAsync(MonitorStatusDto monitor)
    {
        pageError = await RunAsync(async () =>
        {
            var enabled = !monitor.Enabled;
            if (await MonitorService.SetEnabledAsync(monitor.Id, CurrentUser.UserId, enabled, cancellation.Token))
            {
                var index = monitors.FindIndex(m => m.Id == monitor.Id);
                if (index >= 0)
                {
                    monitors[index] = monitors[index] with { Enabled = enabled };
                }
            }
        }, "Monitors_ToggleFailed");
    }

    private async Task DeleteAsync(MonitorStatusDto monitor)
    {
        pageError = await RunAsync(async () =>
        {
            if (await MonitorService.DeleteAsync(monitor.Id, CurrentUser.UserId, cancellation.Token))
            {
                monitors.RemoveAll(m => m.Id == monitor.Id);
            }
        }, "Monitors_DeleteFailed");
    }

    /// <summary>
    /// The only way to touch the data from this page: one operation at a time, because the circuit shares one DbContext.
    /// Returns null on success, otherwise the text to show (the resource <paramref name="failureKey"/> in the
    /// current language; the key is what gets logged); exceptions never escape into the circuit.
    /// </summary>
    private async Task<string?> RunAsync(Func<Task> action, string failureKey)
    {
        if (busy)
        {
            return L["Common_Busy"];
        }

        busy = true;
        Refresh();
        try
        {
            await action();
            return null;
        }
        catch (Exception ex)
        {
            if (isDisposed && ex is OperationCanceledException)
            {
                return null;
            }

            Logger.LogError(ex, "{Operation} failed", failureKey);
            return L[failureKey];
        }
        finally
        {
            busy = false;
            Refresh();
        }
    }

    // AddMonitorForm reports back through a plain delegate, which does not re-render this page by itself.
    private void Refresh()
    {
        if (!isDisposed)
        {
            StateHasChanged();
        }
    }

    // Same order as MonitorService.ListAsync (URL, then id).
    private void InsertSorted(MonitorStatusDto created)
    {
        monitors.RemoveAll(m => m.Id == created.Id);
        var index = monitors.FindIndex(m =>
            string.CompareOrdinal(m.Url, created.Url) is var byUrl && (byUrl > 0 || (byUrl == 0 && m.Id.CompareTo(created.Id) > 0)));
        monitors.Insert(index < 0 ? monitors.Count : index, created);
    }

    private static string StatusDotClass(MonitorStatusDto monitor) =>
        !monitor.Enabled || (!monitor.IsDown && monitor.LastCheckedAt is null) ? "is-paused" : monitor.IsDown ? "is-down" : "is-up";

    public void Dispose()
    {
        isDisposed = true;
        subscription?.Dispose();
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
