@page "/profile"
@attribute [Authorize]
@* No prerender: the page loads the profile once, in the circuit. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

@using UptimeWatch.Application
@using UptimeWatch.Infrastructure.Notifications

@inject IUserProfileStore Profiles
@inject TelegramTestMessageService TestMessages
@inject TelegramOptions TelegramOptions
@inject ICurrentUser CurrentUser
@inject ILogger<Profile> Logger

<PageTitle>@L["Profile_Title"]</PageTitle>

<div class="narrow-card">
    <h1>@L["Profile_Title"]</h1>

    <h2>@L["Profile_Telegram_Title"]</h2>

    @if (!TelegramOptions.IsConfigured)
    {
        <div class="alert alert-warning" role="alert">@L["Profile_Telegram_NotConfiguredBanner"]</div>
    }

    <p class="text-muted">
        @L["Profile_Telegram_Help"]
    </p>

    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (info is not null)
    {
        <div class="alert alert-success" role="status">@info</div>
    }

    @if (loading)
    {
        <div class="state-loading" role="status">@L["Common_Loading"]</div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label" for="chat-id">chat_id</label>
            <input id="chat-id" class="form-control" maxlength="@TelegramChatId.MaxLength" autocomplete="off"
                   @bind="chatId" @bind:event="oninput" disabled="@busy" />
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" disabled="@busy" @onclick="SaveAsync">@L["Profile_Save"]</button>
            <button class="btn btn-outline-secondary" disabled="@busy" @onclick="SendTestAsync">@L["Profile_SendTest"]</button>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private string? chatId;
    private string? error;
    private string? info;
    private bool loading = true;
    private bool busy;
    private bool isDisposed;

    protected override async Task OnInitializedAsync()
    {
        error = await RunAsync(async () =>
        {
            // Always the signed-in user's own profile; no id comes from the browser.
            chatId = await Profiles.GetTelegramChatIdAsync(CurrentUser.UserId, cancellation.Token);
        }, "Profile_LoadFailed");
        loading = false;
    }

    private async Task SaveAsync()
    {
        info = null;
        var normalized = TelegramChatId.Normalize(chatId);
        if (!TelegramChatId.TryValidate(normalized, out var validationError))
        {
            error = L.Text(validationError);
            return;
        }

        error = await RunAsync(async () =>
        {
            await Profiles.SetTelegramChatIdAsync(CurrentUser.UserId, normalized, cancellation.Token);
            chatId = normalized;
            info = normalized is null ? L["Profile_ChatIdRemoved"] : L["Profile_Saved"];
        }, "Profile_SaveFailed");
    }

    private async Task SendTestAsync()
    {
        info = null;
        if (!TelegramOptions.IsConfigured)
        {
            error = L["Profile_Telegram_NotConfigured"];
            return;
        }

        var normalized = TelegramChatId.Normalize(chatId);
        if (normalized is null)
        {
            error = L["Profile_ChatIdRequired"];
            return;
        }

        if (!TelegramChatId.TryValidate(normalized, out var validationError))
        {
            error = L.Text(validationError);
            return;
        }

        string? failure = null;
        error = await RunAsync(async () =>
        {
            try
            {
                var retryAfter = await TestMessages.SendTestAsync(CurrentUser.UserId, normalized, cancellation.Token);
                if (retryAfter is { } wait)
                {
                    failure = L["Profile_RetryAfter", Math.Ceiling(wait.TotalSeconds).ToString("0")];
                    return;
                }

                info = L["Profile_TestSent"];
            }
            catch (TelegramApiException ex)
            {
                // The exception text never contains the token, but the page shows only the status code anyway.
                Logger.LogWarning(ex, "Telegram test message failed");
                failure = ex.StatusCode is { } status
                    ? L["Profile_TestFailedHttp", status]
                    : L["Profile_TestFailedUnavailable"];
            }
        }, "Profile_TestFailed");

        error ??= failure;
    }

    /// <summary>One operation at a time (the circuit shares one DbContext). Returns null on success, otherwise the text to show (the localized <paramref name="failureKey"/>).</summary>
    private async Task<string?> RunAsync(Func<Task> action, string failureKey)
    {
        if (busy)
        {
            return L["Common_Busy"];
        }

        busy = true;
        Refresh();
        try
        {
            await action();
            return null;
        }
        catch (Exception ex)
        {
            if (isDisposed && ex is OperationCanceledException)
            {
                return null;
            }

            Logger.LogError(ex, "{Operation} failed", failureKey);
            return L[failureKey];
        }
        finally
        {
            busy = false;
            Refresh();
        }
    }

    private void Refresh()
    {
        if (!isDisposed)
        {
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        isDisposed = true;
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
