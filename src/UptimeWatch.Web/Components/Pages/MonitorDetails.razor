@page "/monitors/{Id:guid}"
@attribute [Authorize]

@using UptimeWatch.Application
@using UptimeWatch.Domain

@inject MonitorService MonitorService
@inject ICheckResultRepository Results
@inject ICurrentUser CurrentUser

<PageTitle>Монитор</PageTitle>

@if (!loaded)
{
    <div class="state-loading" role="status">Загрузка...</div>
}
else if (monitor is null)
{
    <a class="back-link" href="monitors">← Мониторы</a>
    <div class="state-empty">
        <strong>Не найдено</strong>
        Такого монитора нет, либо он принадлежит другому аккаунту.
    </div>
}
else
{
    <a class="back-link" href="monitors">← Мониторы</a>

    <div class="page-head">
        <h1 class="text-break">@MonitorUrl.Domain(monitor.Url)</h1>
        <StatusBadge Monitor="monitor" />
    </div>
    <p class="text-muted text-break">@monitor.Url</p>

    <div class="details-uptime">
        <div class="uptime-bars">
            <UptimeBar Label="Аптайм 24ч" Value="monitor.Uptime.Last24h" />
            <UptimeBar Label="Аптайм 7д" Value="monitor.Uptime.Last7d" />
            <UptimeBar Label="Аптайм 30д" Value="monitor.Uptime.Last30d" />
        </div>
    </div>

    <h2 class="section-title">Инциденты (последние @IncidentCount)</h2>
    @if (incidents.Count == 0)
    {
        <div class="state-empty">Инцидентов не было.</div>
    }
    else
    {
        <ol class="timeline">
            @foreach (var incident in incidents)
            {
                <li class="timeline-item">
                    <span class="status-dot @(incident.EndedAt is null ? "is-down" : "is-paused")" aria-hidden="true"></span>
                    <div class="timeline-body">
                        <div class="timeline-title">
                            @if (incident.EndedAt is null)
                            {
                                <span class="badge badge-down">Идёт</span>
                            }
                            else
                            {
                                <span class="badge badge-paused">Завершён</span>
                            }
                            <span class="timeline-meta">
                                @FormatTime(incident.StartedAt) UTC
                                @if (incident.EndedAt is { } ended)
                                {
                                    <text>— @FormatTime(ended) UTC</text>
                                }
                            </span>
                            <span class="timeline-meta">Длительность: @(incident.Duration is { } duration ? DurationFormatter.Format(duration) : "—")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(incident.LastError))
                        {
                            <div class="timeline-error">@incident.LastError</div>
                        }
                    </div>
                </li>
            }
        </ol>
    }

    <h2 class="section-title">Последние проверки (@ResultCount)</h2>
    @if (results.Count == 0)
    {
        <div class="state-empty">Проверок ещё не было.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-sm">
                <thead>
                    <tr><th>Время (UTC)</th><th>Результат</th><th>Код</th><th>Время ответа, мс</th><th>Ошибка</th></tr>
                </thead>
                <tbody>
                    @foreach (var result in results)
                    {
                        <tr>
                            <td>@FormatTime(result.CheckedAt)</td>
                            <td><span class="@(result.Success ? "result-ok" : "result-fail")">@(result.Success ? "OK" : "Сбой")</span></td>
                            <td>@(result.StatusCode?.ToString() ?? "—")</td>
                            <td>@result.ResponseTimeMs</td>
                            <td class="text-break">@result.Error</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int ResultCount = 50;
    private const int IncidentCount = 20;

    private MonitorStatusDto? monitor;
    private IReadOnlyList<CheckResult> results = [];
    private IReadOnlyList<Incident> incidents = [];
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // GetAsync filters by the signed-in owner: another user's id looks exactly like a missing one.
        monitor = await MonitorService.GetAsync(Id, CurrentUser.UserId, CancellationToken.None);
        if (monitor is not null)
        {
            results = await Results.GetRecentAsync(monitor.Id, ResultCount, CancellationToken.None);
            incidents = await Results.GetIncidentsAsync(monitor.Id, IncidentCount, CancellationToken.None);
        }

        loaded = true;
    }

    private static string FormatTime(DateTime value) => value.ToString("yyyy-MM-dd HH:mm:ss");
}
