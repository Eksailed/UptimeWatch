@page "/monitors/{Id:guid}"
@attribute [Authorize]

@using System.Globalization
@using UptimeWatch.Application
@using UptimeWatch.Domain

@inject MonitorService MonitorService
@inject ICheckResultRepository Results
@inject ICurrentUser CurrentUser

<PageTitle>@L["Details_Title"]</PageTitle>

@if (!loaded)
{
    <div class="state-loading" role="status">@L["Common_Loading"]</div>
}
else if (monitor is null)
{
    <a class="back-link" href="monitors">← @L["Nav_Monitors"]</a>
    <div class="state-empty">
        <strong>@L["Details_NotFound_Title"]</strong>
        @L["Details_NotFound_Text"]
    </div>
}
else
{
    <a class="back-link" href="monitors">← @L["Nav_Monitors"]</a>

    <div class="page-head">
        <h1 class="text-break">@MonitorUrl.Domain(monitor.Url)</h1>
        <StatusBadge Monitor="monitor" />
    </div>
    <p class="text-muted text-break">@monitor.Url</p>

    <div class="details-uptime">
        <div class="uptime-bars">
            <UptimeBar Label="@L["Details_Uptime24h"]" Value="monitor.Uptime.Last24h" />
            <UptimeBar Label="@L["Details_Uptime7d"]" Value="monitor.Uptime.Last7d" />
            <UptimeBar Label="@L["Details_Uptime30d"]" Value="monitor.Uptime.Last30d" />
        </div>
    </div>

    <h2 class="section-title">@L["Details_Incidents", IncidentCount]</h2>
    @if (incidents.Count == 0)
    {
        <div class="state-empty">@L["Details_NoIncidents"]</div>
    }
    else
    {
        <ol class="timeline">
            @foreach (var incident in incidents)
            {
                <li class="timeline-item">
                    <span class="status-dot @(incident.EndedAt is null ? "is-down" : "is-paused")" aria-hidden="true"></span>
                    <div class="timeline-body">
                        <div class="timeline-title">
                            @if (incident.EndedAt is null)
                            {
                                <span class="badge badge-down">@L["Details_Incident_Ongoing"]</span>
                            }
                            else
                            {
                                <span class="badge badge-paused">@L["Details_Incident_Resolved"]</span>
                            }
                            <span class="timeline-meta">
                                @UiFormat.Time(incident.StartedAt)
                                @if (incident.EndedAt is { } ended)
                                {
                                    <text>— @UiFormat.Time(ended)</text>
                                }
                            </span>
                            <span class="timeline-meta">@L["Details_Duration", incident.Duration is { } duration ? DurationFormatter.Format(duration, CultureInfo.CurrentUICulture) : "—"]</span>
                        </div>
                        @if (!string.IsNullOrEmpty(incident.LastError))
                        {
                            <div class="timeline-error">@incident.LastError</div>
                        }
                    </div>
                </li>
            }
        </ol>
    }

    <h2 class="section-title">@L["Details_Checks", ResultCount]</h2>
    @if (results.Count == 0)
    {
        <div class="state-empty">@L["Details_NoChecks"]</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-sm">
                <thead>
                    <tr><th>@L["Details_Col_Time"]</th><th>@L["Details_Col_Result"]</th><th>@L["Details_Col_Code"]</th><th>@L["Details_Col_ResponseMs"]</th><th>@L["Details_Col_Error"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var result in results)
                    {
                        <tr>
                            <td>@UiFormat.Time(result.CheckedAt, withZone: false)</td>
                            <td><span class="@(result.Success ? "result-ok" : "result-fail")">@(result.Success ? L["Details_Result_Ok"] : L["Details_Result_Fail"])</span></td>
                            <td>@(result.StatusCode?.ToString() ?? "—")</td>
                            <td>@result.ResponseTimeMs</td>
                            <td class="text-break">@result.Error</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int ResultCount = 50;
    private const int IncidentCount = 20;

    private MonitorStatusDto? monitor;
    private IReadOnlyList<CheckResult> results = [];
    private IReadOnlyList<Incident> incidents = [];
    private bool loaded;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // GetAsync filters by the signed-in owner: another user's id looks exactly like a missing one.
        monitor = await MonitorService.GetAsync(Id, CurrentUser.UserId, CancellationToken.None);
        if (monitor is not null)
        {
            results = await Results.GetRecentAsync(monitor.Id, ResultCount, CancellationToken.None);
            incidents = await Results.GetIncidentsAsync(monitor.Id, IncidentCount, CancellationToken.None);
        }

        loaded = true;
    }
}
