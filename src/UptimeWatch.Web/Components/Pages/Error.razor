@page "/Error"
@using System.Diagnostics

<PageTitle>@L["ErrorPage_Title"]</PageTitle>

<div class="narrow-card error-card">
    <h1>@L["ErrorPage_Title"]</h1>
    <p>@L["ErrorPage_Text"]</p>

    @if (ShowRequestId)
    {
        <p class="text-muted mb-0">
            @L["ErrorPage_RequestId"] <code>@RequestId</code>
        </p>
    }

    <a class="btn btn-primary mt-3" href="">@L["ErrorPage_Home"]</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
