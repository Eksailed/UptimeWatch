@page "/Error"
@using System.Diagnostics

<PageTitle>Ошибка</PageTitle>

<div class="narrow-card error-card">
    <h1>Ошибка</h1>
    <p>Не удалось обработать запрос. Попробуйте ещё раз чуть позже.</p>

    @if (ShowRequestId)
    {
        <p class="text-muted mb-0">
            Идентификатор запроса: <code>@RequestId</code>
        </p>
    }

    <a class="btn btn-primary mt-3" href="">На главную</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
