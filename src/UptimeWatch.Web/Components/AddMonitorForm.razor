@using System.ComponentModel.DataAnnotations
@using UptimeWatch.Application

@inject MonitorService MonitorService
@inject ICurrentUser CurrentUser

<EditForm Model="input" OnValidSubmit="SubmitAsync" FormName="add-monitor" class="card card-body mb-4">
    <DataAnnotationsValidator />
    <div class="row g-2 align-items-end">
        <div class="col-lg-6">
            <label for="monitor-url" class="form-label">Адрес сайта</label>
            <InputText id="monitor-url" class="form-control" @bind-Value="input.Url" placeholder="https://example.com" />
        </div>
        <div class="col-lg-2 col-6">
            <label for="monitor-interval" class="form-label">Интервал, с</label>
            <InputNumber id="monitor-interval" class="form-control" @bind-Value="input.IntervalSeconds" />
        </div>
        <div class="col-lg-2 col-6">
            <label for="monitor-code" class="form-label">Ожидаемый код</label>
            <InputNumber id="monitor-code" class="form-control" @bind-Value="input.ExpectedStatusCode" />
        </div>
        <div class="col-lg-2">
            <button type="submit" class="btn btn-primary w-100" disabled="@submitting">Добавить</button>
        </div>
    </div>
    <ValidationSummary class="text-danger mt-2" />
    @if (error is not null)
    {
        <div class="alert alert-danger mt-2 mb-0" role="alert">@error</div>
    }
</EditForm>

@code {
    private readonly InputModel input = new();
    private string? error;
    private bool submitting;

    [Parameter]
    public EventCallback<MonitorStatusDto> OnCreated { get; set; }

    private async Task SubmitAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        error = null;
        try
        {
            var result = await MonitorService.CreateAsync(
                CurrentUser.UserId, input.Url, input.IntervalSeconds, input.ExpectedStatusCode, CancellationToken.None);
            if (result.Value is { } created)
            {
                input.Url = string.Empty;
                await OnCreated.InvokeAsync(created);
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            submitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Укажите адрес сайта.")]
        public string Url { get; set; } = string.Empty;

        public int IntervalSeconds { get; set; } = 60;

        public int ExpectedStatusCode { get; set; } = 200;
    }
}
