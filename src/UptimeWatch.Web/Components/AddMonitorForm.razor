<EditForm Model="input" OnValidSubmit="SubmitAsync" FormName="add-monitor" class="add-panel">
    <DataAnnotationsValidator />
    <div class="row g-2 align-items-end">
        <div class="col-lg-6">
            <label for="monitor-url" class="form-label">@L["Add_Url"]</label>
            <InputText id="monitor-url" class="form-control" @bind-Value="input.Url" placeholder="https://example.com" />
        </div>
        <div class="col-lg-2 col-6">
            <label for="monitor-interval" class="form-label">@L["Add_Interval"]</label>
            <InputNumber id="monitor-interval" class="form-control" @bind-Value="input.IntervalSeconds" ParsingErrorMessage="@L["Validation_Interval_Number"]" />
        </div>
        <div class="col-lg-2 col-6">
            <label for="monitor-code" class="form-label">@L["Add_ExpectedCode"]</label>
            <InputNumber id="monitor-code" class="form-control" @bind-Value="input.ExpectedStatusCode" ParsingErrorMessage="@L["Validation_ExpectedCode_Number"]" />
        </div>
        <div class="col-lg-2">
            <button type="submit" class="btn btn-primary w-100" disabled="@Busy">@L["Add_Submit"]</button>
        </div>
    </div>
    <ValidationSummary class="text-danger mt-2 mb-0" />
    @if (error is not null)
    {
        <div class="alert alert-danger mt-2 mb-0" role="alert">@error</div>
    }
</EditForm>

@code {
    private readonly InputModel input = new();
    private string? error;

    /// <summary>True while the page runs any operation; the page owns the guard so operations cannot overlap.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Creates the monitor (url, interval, expected code); returns an error text, or null on success.</summary>
    [Parameter, EditorRequired]
    public Func<string, int, int, Task<string?>> OnSubmit { get; set; } = default!;

    private async Task SubmitAsync()
    {
        error = await OnSubmit(input.Url, input.IntervalSeconds, input.ExpectedStatusCode);
        if (error is null)
        {
            input.Url = string.Empty;
        }
    }

    private sealed class InputModel
    {
        [LocalizedRequired("Validation_Url_Required")]
        public string Url { get; set; } = string.Empty;

        public int IntervalSeconds { get; set; } = 60;

        public int ExpectedStatusCode { get; set; } = 200;
    }
}
