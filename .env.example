# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Password of the PostgreSQL user "uptimewatch". REQUIRED and intentionally left empty: docker compose refuses
# to start until you set your own value. The app receives it via PGPASSWORD, so ';' and '=' are fine, but the
# value goes through the .env parser: do not use '$', quotes, spaces or '#' in it (use letters, digits and
# symbols such as - _ . , : ! @ % ^ * ( ) ; =).
POSTGRES_PASSWORD=

# Telegram bot token from @BotFather (looks like 123456789:AA...). Optional: when empty,
# alerts are only written to the log and the profile page says that Telegram is not configured.
TELEGRAM_BOT_TOKEN=
