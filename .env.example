# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Password of the PostgreSQL user "uptimewatch". Required. Pick your own value and do not use ';' in it
# (it is embedded into an Npgsql connection string).
POSTGRES_PASSWORD=change-me

# Telegram bot token from @BotFather (looks like 123456789:AA...). Optional: when empty,
# alerts are only written to the log and the profile page says that Telegram is not configured.
TELEGRAM_BOT_TOKEN=
